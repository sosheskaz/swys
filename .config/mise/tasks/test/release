#!/usr/bin/env bash
#MISE description="Verify notices in every archive and smoke test the host binary"
set -euo pipefail

archive=$(jq -er --arg os "$(go env GOHOSTOS)" --arg arch "$(go env GOHOSTARCH)" '
  [.[] | select(.type == "Archive" and .goos == $os and .goarch == $arch)]
  | if length == 1 then .[0].path else error("expected one host-platform archive") end
' dist/artifacts.json)
release_version=$(jq -er '.version | select(length > 0 and . != "dev" and . != "(devel)")' dist/metadata.json)
release_commit=$(git rev-parse HEAD)
# GoReleaser normalizes CommitDate to UTC RFC3339.
release_date=$(TZ=UTC git show -s --date=format-local:%Y-%m-%dT%H:%M:%SZ --format=%cd HEAD)

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
umask 077
payload_files=(LICENSE LICENSING.md THIRD_PARTY_NOTICES.txt README.md)
if [[ -f CHANGELOG.md ]]; then
  payload_files+=(CHANGELOG.md)
fi
jq -er '
  [.[] | select(.type == "Archive")]
  | if length > 0 then .[].path else error("expected release archives") end
' dist/artifacts.json >"$scratch/archives"
archive_count=0
while IFS= read -r payload_archive; do
  archive_count=$((archive_count + 1))
  payload_dir="$scratch/archive-$archive_count"
  mkdir "$payload_dir"
  case "$payload_archive" in
    *.tar.gz) tar -xzf "$payload_archive" -C "$payload_dir" "${payload_files[@]}" ;;
    *.zip) unzip -oq "$payload_archive" "${payload_files[@]}" -d "$payload_dir" ;;
    *)
      printf 'unsupported archive format: %s\n' "$payload_archive" >&2
      exit 1
      ;;
  esac
  for file in "${payload_files[@]}"; do
    cmp "$file" "$payload_dir/$file"
  done
done <"$scratch/archives"
printf 'Canonical notices and documentation verified in %s archives\n' "$archive_count"
tar -xzf "$archive" -C "$scratch" swys
binary="$scratch/swys"
actual_version=$("$binary" --version)
expected_version="swys version $release_version (commit ${release_commit:0:12}, built $release_date)"
if [[ "$actual_version" != "$expected_version" && "$actual_version" != "${expected_version%\)}, dirty)" ]]; then
  printf 'unexpected packaged version: %s\nexpected: %s\n' "$actual_version" "$expected_version" >&2
  exit 1
fi
"$binary" --help >"$scratch/help"
grep -q 'Usage:' "$scratch/help"
printf '0123456789abcdef0123456789abcdef' >"$scratch/fixture.key"
printf 'packaged AES round trip\n\000\377' >"$scratch/plaintext"
"$binary" aes encrypt --key "$scratch/fixture.key" --input "$scratch/plaintext" --output "$scratch/ciphertext"
"$binary" aes decrypt --key "$scratch/fixture.key" --input "$scratch/ciphertext" --output "$scratch/decrypted"
cmp "$scratch/plaintext" "$scratch/decrypted"
printf 'Packaged binary smoke test passed: %s\n' "$archive"
