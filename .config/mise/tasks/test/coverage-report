#!/usr/bin/env bash
#MISE description="Test coverage-report aggregation"
set -euo pipefail

task_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
reporter="${task_dir}/../report/coverage"
baseline_fetcher="${task_dir}/../report/coverage-baseline"
temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/npc-coverage-report.XXXXXX")"
trap 'rm -rf -- "$temp_dir"' EXIT

base_profile="${temp_dir}/base.out"
head_profile="${temp_dir}/head.out"

printf '%s\n' \
  'mode: atomic' \
  'github.com/sosheskaz-systems/npc/cmd/example.go:1.1,1.2 1 1' \
  'github.com/sosheskaz-systems/npc/cmd/example.go:2.1,2.2 1 0' \
  >"$base_profile"

printf '%s\n' \
  'mode: atomic' \
  'github.com/sosheskaz-systems/npc/cmd/example.go:1.1,1.2 1 0' \
  'github.com/sosheskaz-systems/npc/cmd/example.go:2.1,2.2 1 0' \
  'github.com/sosheskaz-systems/npc/internal/securefile/securefile.go:1.1,1.2 1 1' \
  'github.com/sosheskaz-systems/npc/cmd/example.go:1.1,1.2 1 1' \
  'github.com/sosheskaz-systems/npc/cmd/example.go:2.1,2.2 1 0' \
  'github.com/sosheskaz-systems/npc/internal/securefile/securefile.go:1.1,1.2 1 0' \
  >"$head_profile"

output="$($reporter "$head_profile" "$base_profile")"

assert_contains() {
  local expected="$1"
  if ! grep -Fq -- "$expected" <<<"$output"; then
    printf 'coverage report missing expected line: %s\n\n%s\n' "$expected" "$output" >&2
    return 1
  fi
}

assert_contains '**Total: 66.7%** (recorded base: 50.0%, +16.7 🟢)'
# shellcheck disable=SC2016 # Markdown code spans are intentional literals.
assert_contains '| `cmd` | 50.0% | 50.0% | ±0.0 |'
# shellcheck disable=SC2016 # Markdown code spans are intentional literals.
assert_contains '| `internal/securefile` | 100.0% | — | new |'

base_sha='0123456789abcdef0123456789abcdef01234567'
run_id='123456789'
fake_bin="${temp_dir}/bin"
fake_log="${temp_dir}/gh.log"
fake_artifact="${temp_dir}/artifact.out"
mkdir -p "$fake_bin"
cp "$base_profile" "$fake_artifact"
cat >"${fake_bin}/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"$FAKE_GH_LOG"
if [[ "$1 $2" == "run list" ]]; then
  if [[ "${FAKE_NO_RUN:-}" != 1 ]]; then
    printf '%s\t%s\n' "$FAKE_RUN_ID" "$FAKE_RUN_SHA"
  fi
elif [[ "$1" == api ]]; then
  endpoint=''
  for argument in "$@"; do
    if [[ "$argument" == repos/* ]]; then
      endpoint="$argument"
      break
    fi
  done
  if [[ "$endpoint" == */actions/runs/*/artifacts ]]; then
    if [[ "${FAKE_NO_ARTIFACT:-}" != 1 ]]; then
      printf '987654321\n'
    fi
  else
    exit 2
  fi
elif [[ "$1 $2" == "run download" ]]; then
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == --dir ]]; then
      cp "$FAKE_ARTIFACT" "$2/coverage.out"
      exit 0
    fi
    shift
  done
  exit 2
else
  exit 2
fi
EOF
chmod +x "${fake_bin}/gh"

# PR checks publish a summary without invoking any comment API.
: >"$fake_log"
summary="${temp_dir}/step-summary"
PATH="${fake_bin}:${PATH}" \
  FAKE_GH_LOG="$fake_log" \
  GITHUB_REPOSITORY='owner/project' \
  GITHUB_STEP_SUMMARY="$summary" \
  PR_NUMBER=123 \
  "$reporter" "$head_profile" "$base_profile" >"${temp_dir}/report.md"
cmp "$summary" "${temp_dir}/report.md"
if [[ -s "$fake_log" ]]; then
  echo 'summary-only coverage reporting called the GitHub API' >&2
  exit 1
fi

baseline_output="${temp_dir}/coverage-base.out"
github_output="${temp_dir}/github-output"
PATH="${fake_bin}:${PATH}" \
  FAKE_GH_LOG="$fake_log" \
  FAKE_RUN_ID="$run_id" \
  FAKE_RUN_SHA="$base_sha" \
  FAKE_ARTIFACT="$fake_artifact" \
  GITHUB_OUTPUT="$github_output" \
  GITHUB_REPOSITORY='sosheskaz-systems/npc' \
  "$baseline_fetcher" "$base_sha" "$baseline_output"
cmp "$fake_artifact" "$baseline_output"
grep -Fq -- "--commit ${base_sha}" "$fake_log"
grep -Fxq -- "run_id=${run_id}" "$github_output"
grep -Fxq -- 'artifact_id=987654321' "$github_output"
grep -Fxq -- 'available=true' "$github_output"

: >"$github_output"
PATH="${fake_bin}:${PATH}" \
  FAKE_GH_LOG="$fake_log" \
  FAKE_RUN_ID="$run_id" \
  FAKE_RUN_SHA="$base_sha" \
  FAKE_ARTIFACT="$fake_artifact" \
  FAKE_NO_ARTIFACT=1 \
  GITHUB_OUTPUT="$github_output" \
  GITHUB_REPOSITORY='sosheskaz-systems/npc' \
  "$baseline_fetcher" "$base_sha" "$baseline_output"
if [[ -e "$baseline_output" ]]; then
  echo 'coverage baseline fetcher retained output after a missing exact artifact' >&2
  exit 1
fi
grep -Fxq -- 'available=false' "$github_output"

: >"$github_output"
PATH="${fake_bin}:${PATH}" \
  FAKE_GH_LOG="$fake_log" \
  FAKE_RUN_ID="$run_id" \
  FAKE_RUN_SHA="$base_sha" \
  FAKE_ARTIFACT="$fake_artifact" \
  FAKE_NO_RUN=1 \
  GITHUB_OUTPUT="$github_output" \
  GITHUB_REPOSITORY='sosheskaz-systems/npc' \
  "$baseline_fetcher" "$base_sha" "$baseline_output"
if [[ -e "$baseline_output" ]]; then
  echo 'coverage baseline fetcher retained output when the exact-base run was unavailable' >&2
  exit 1
fi
grep -Fxq -- 'available=false' "$github_output"
if grep -Fq -- 'run_id=' "$github_output"; then
  echo 'coverage baseline fetcher reported a fallback run for a missing exact-base run' >&2
  exit 1
fi

metadata_output="$(
  COVERAGE_BASE_ARTIFACT_ID='987654321' \
    COVERAGE_BASE_RUN_ID="$run_id" \
    COVERAGE_BASE_SHA="$base_sha" \
    COVERAGE_CHECKOUT_SHA='1111111111111111111111111111111111111111' \
    COVERAGE_HEAD_SHA='2222222222222222222222222222222222222222' \
    COVERAGE_RUN_ID='333333333' \
    COVERAGE_RUN_ATTEMPT='2' \
    "$reporter" "$head_profile"
)"
if ! grep -Fq -- "comparison unavailable for recorded base \`${base_sha}\`" <<<"$metadata_output"; then
  echo "coverage report did not identify the unavailable recorded-base comparison" >&2
  exit 1
fi
if ! grep -Fq -- '<!-- npc-coverage-run:333333333:2 -->' <<<"$metadata_output"; then
  echo "coverage report did not include monotonic publication provenance" >&2
  exit 1
fi
# shellcheck disable=SC2016 # Markdown code spans are intentional literals.
if ! grep -Fq -- 'checkout: `1111111111111111111111111111111111111111`; PR head: `2222222222222222222222222222222222222222`; recorded base: `0123456789abcdef0123456789abcdef01234567`; PR run: `333333333` attempt `2`; baseline run: `123456789`; baseline artifact: `987654321`' <<<"$metadata_output"; then
  echo "coverage report did not include auditable run identities" >&2
  exit 1
fi
