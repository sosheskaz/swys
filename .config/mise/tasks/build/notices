#!/usr/bin/env bash
#MISE description="Stage canonical project and runtime notices for ko images"
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)
cd "$root"
notices=(LICENSE LICENSING.md THIRD_PARTY_NOTICES.txt)
for notice in "${notices[@]}"; do
  if [[ ! -f "$notice" || -L "$notice" ]]; then
    printf 'expected a canonical regular notice file: %s\n' "$notice" >&2
    exit 1
  fi
done

# ko includes the entire kodata tree, so keep this generated tree allowlisted.
if [[ -L kodata || (-e kodata && ! -d kodata) ]]; then
  printf 'expected a generated kodata directory\n' >&2
  exit 1
fi
shopt -s nullglob dotglob
for entry in kodata/*; do
  if [[ "$entry" != kodata/licenses || ! -d "$entry" || -L "$entry" ]]; then
    printf 'unexpected entry in generated kodata: %s\n' "$entry" >&2
    exit 1
  fi
done
for entry in kodata/licenses/*; do
  case "$entry" in
    kodata/licenses/LICENSE | kodata/licenses/LICENSING.md | kodata/licenses/THIRD_PARTY_NOTICES.txt)
      if [[ ! -f "$entry" || -L "$entry" ]]; then
        printf 'expected a generated regular notice file: %s\n' "$entry" >&2
        exit 1
      fi
      ;;
    *)
      printf 'unexpected entry in generated notices: %s\n' "$entry" >&2
      exit 1
      ;;
  esac
done
mkdir -p kodata/licenses
for notice in "${notices[@]}"; do
  cp "$notice" "kodata/licenses/$notice"
  chmod 0644 "kodata/licenses/$notice"
done
