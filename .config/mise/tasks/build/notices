#!/usr/bin/env bash
#MISE description="Stage canonical project and container-base notices for ko images"
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)
cd "$root"
notices=(
  LICENSE LICENSING.md THIRD_PARTY_NOTICES.txt
  licenses/oci/README.md
  licenses/oci/linux-amd64.spdx.json
  licenses/oci/linux-arm64.spdx.json
)
destinations=()
for notice in "${notices[@]}"; do
  if [[ ! -f "$notice" || -L "$notice" ]]; then
    printf 'expected a canonical regular notice file: %s\n' "$notice" >&2
    exit 1
  fi
  destinations+=("kodata/licenses/${notice#licenses/}")
done

# ko includes the entire kodata tree, so keep this generated tree allowlisted.
directories=(kodata kodata/licenses kodata/licenses/oci)
for directory in "${directories[@]}"; do
  if [[ -L "$directory" || (-e "$directory" && ! -d "$directory") ]]; then
    printf 'expected a generated notice directory: %s\n' "$directory" >&2
    exit 1
  fi
done
shopt -s nullglob dotglob
for entry in kodata/* kodata/licenses/* kodata/licenses/oci/*; do
  case "$entry" in
    kodata/licenses | kodata/licenses/oci) continue ;;
  esac
  allowed=false
  for destination in "${destinations[@]}"; do
    if [[ "$entry" == "$destination" && -f "$entry" && ! -L "$entry" ]]; then
      allowed=true
      break
    fi
  done
  if [[ "$allowed" != true ]]; then
    printf 'unexpected entry in generated notices: %s\n' "$entry" >&2
    exit 1
  fi
done
mkdir -p kodata/licenses/oci
for i in "${!notices[@]}"; do
  cp "${notices[$i]}" "${destinations[$i]}"
  chmod 0644 "${destinations[$i]}"
done
