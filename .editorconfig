root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[mise-tasks/**]
indent_style = space
indent_size = 2
shell_variant = bash
switch_case_indent = true

[Makefile]
indent_style = tab
