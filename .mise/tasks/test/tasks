#!/usr/bin/env bash
#MISE description="Test fuzz/benchmark task behavior against a small local Go module"
set -euo pipefail
fail() {
  printf 'task check failed at line %s\n' "$1" >&2
  exit 1
}
trap 'fail "$LINENO"' ERR
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
fuzz="$root/.mise/tasks/test/fuzz"
bench="$root/.mise/lib/bench.sh"
temporary="$(mktemp -d "${TMPDIR:-/tmp}/npc-task-tests.XXXXXX")"
trap 'rm -rf -- "$temporary"' EXIT
cd "$temporary"
# Exercise the runner independently of caller selections and budgets.
unset usage_package usage_target usage_list usage_preset usage_fuzztime \
  usage_package_workers usage_fuzz_workers usage_bench usage_benchtime \
  usage_count usage_output_dir NPC_TEST_PACKAGE_WORKERS NPC_FUZZ_WORKERS
export GOWORK=off NPC_FUZZ_WORKERS=1
cat >go.mod <<'GO'
module taskfixture

go 1.27.1
GO
cat >behavior_test.go <<'GO'
package taskfixture

import (
    "os"
    "testing"
)

func FuzzOne(f *testing.F) {
    f.Add("seed")
    f.Fuzz(func(t *testing.T, value string) {
        if os.Getenv("NPC_TASK_FIXTURE_FAIL") == "1" {
            t.Fatal("fixture fuzz failure")
        }
    })
}
func FuzzTwo(f *testing.F) {
    f.Add([]byte("seed"))
    f.Fuzz(func(t *testing.T, value []byte) {})
}
func BenchmarkOne(b *testing.B) {
    if os.Getenv("NPC_TASK_FIXTURE_FAIL") == "1" {
        b.Fatal("fixture benchmark failure")
    }
    for b.Loop() {}
}
GO
# These must be ignored by build-aware discovery, even though they look like tests.
cat >excluded_fuzz_test.go <<'GO'
//go:build npc_task_excluded

package taskfixture
invalid Go syntax
GO
mkdir -p .worktrees/stale
printf 'package stale\ninvalid Go syntax\n' >.worktrees/stale/invalid_test.go

expect_failure() {
  local message="$1"
  shift
  if "$@" >"$temporary/failure.log" 2>&1; then
    printf 'expected failure: %s\n' "$*" >&2
    exit 1
  fi
  if ! grep -Fq -- "$message" "$temporary/failure.log"; then
    cat "$temporary/failure.log" >&2
    printf 'missing diagnostic: %s\n' "$message" >&2
    exit 1
  fi
}

listing="$(usage_list=true "$fuzz")"
[[ "$listing" == $'taskfixture\tFuzzOne\ntaskfixture\tFuzzTwo' ]] || fail "$LINENO"
listing="$(usage_target=FuzzTwo usage_list=true "$fuzz")"
[[ "$listing" == $'taskfixture\tFuzzTwo' ]] || fail "$LINENO"
# CLI-shaped values override environment defaults; the explicit budget wins over explore.
output="$(NPC_FUZZ_WORKERS=2 NPC_TEST_PACKAGE_WORKERS=2 usage_package_workers=1 \
  usage_fuzz_workers=1 usage_preset=explore usage_fuzztime=1x usage_target=FuzzOne "$fuzz")"
[[ "$output" == *'FuzzOne (1x; fuzz workers=1; package workers=1)'* ]] || fail "$LINENO"
[[ "$output" == *'completed 1 fuzz targets'* ]] || fail "$LINENO"
output="$("$fuzz")"
[[ "$output" == *'FuzzOne (100x;'* && "$output" == *'FuzzTwo (100x;'* ]] || fail "$LINENO"
[[ "$output" == *'completed 2 fuzz targets'* ]] || fail "$LINENO"
expect_failure 'no runnable fuzz targets' env usage_target=FuzzMissing "$fuzz"
expect_failure 'no runnable fuzz targets' env 'usage_target=Fuzz\One' "$fuzz"
expect_failure 'positive integer' env usage_fuzz_workers=0 "$fuzz"
expect_failure 'positive Go duration' env usage_fuzztime=0s "$fuzz"
expect_failure 'fixture fuzz failure' env NPC_TASK_FIXTURE_FAIL=1 usage_target=FuzzOne "$fuzz"

listing="$(usage_list=true "$bench" run)"
[[ "$listing" == $'taskfixture\tBenchmarkOne' ]] || fail "$LINENO"
output="$(usage_bench='^BenchmarkOne$' usage_benchtime=1x "$bench" run)"
[[ "$output" == *BenchmarkOne* ]] || fail "$LINENO"
expect_failure 'no benchmarks ran' env usage_bench=DoesNotExist usage_benchtime=1x "$bench" run
expect_failure 'bench must not be empty' env usage_bench= usage_benchtime=1x "$bench" run
expect_failure 'fixture benchmark failure' env NPC_TASK_FIXTURE_FAIL=1 usage_benchtime=1x "$bench" run
for mode in cpu mem; do
  usage_benchtime=1x usage_output_dir="$temporary/profiles with spaces" "$bench" "$mode" >"$temporary/profile.log"
  directory="$temporary/profiles with spaces/taskfixture/$mode"
  [[ -s "$directory/bench.test" && -s "$directory/$mode.prof" ]] || fail "$LINENO"
  go tool pprof -top "$directory/bench.test" "$directory/$mode.prof" >/dev/null
  [[ ! -e taskfixture.test && ! -e "$mode.prof" ]] || fail "$LINENO"
done

printf 'this is not Go\n' >broken.go
expect_failure 'expected' env usage_list=true "$fuzz"
printf 'task runner checks passed\n'
